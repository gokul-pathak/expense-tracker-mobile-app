# Server-side secrets for Supabase Edge Functions. NOT the app's .env.
#
# Set real values per project with `supabase secrets set NAME=value`, or copy
# this file to supabase/functions/.env for `supabase functions serve` locally.
# That .env file is ignored by Git. Never put these in the app's .env: every
# EXPO_PUBLIC_ variable is bundled into the app.
#
# SUPABASE_URL and the project's publishable keys are provided to deployed
# functions automatically and are not set here.

# The provider key. Only ever present in the function's environment.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5 at low effort.
AI_SUGGESTION_MODEL=

# Optional. Set to "disabled" to turn suggestions off for this project without
# redeploying the app. Suggestions are also off whenever ANTHROPIC_API_KEY is unset.
AI_SUGGESTION_PROVIDER=
