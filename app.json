{
  "expo": {
    "name": "Expense Tracker",
    "slug": "personal-expense-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your personal finance data."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Expense Tracker to use the camera so you can scan a receipt. Recording expenses by hand never needs the camera.",
          "photosPermission": "Allow Expense Tracker to access your photos so you can import a receipt you already took.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    }
  }
}
